# ============================================================
# PakPrice API — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit the .env file to version control.
#
# IMPORTANT SECURITY RULES:
#   • SUPABASE_SERVICE_ROLE_KEY must ONLY be set here (server-side).
#     It must NEVER be sent to or used by the frontend (apps/web).
#   • The frontend (apps/web) uses only NEXT_PUBLIC_SUPABASE_ANON_KEY.
# ============================================================

NODE_ENV=development
PORT=4000

# Supabase project URL — find it in Supabase dashboard > Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon (public) key — safe for read operations respecting RLS
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase service-role key — bypasses RLS, KEEP SECRET, server-side only
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Allowed CORS origin(s) for the frontend
CORS_ORIGIN=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
