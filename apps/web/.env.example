# ============================================================
# PakPrice Web — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
#
# SECURITY NOTE:
#   • Only NEXT_PUBLIC_* variables are safe to use on the client.
#   • NEVER put SUPABASE_SERVICE_ROLE_KEY here.
#   • The service-role key lives ONLY in apps/api/.env
# ============================================================

# URL of the PakPrice API (apps/api)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase project URL — safe to expose (used for anon operations only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon key — safe to expose (RLS enforced on all user tables)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Canonical URL for SEO (set to your production domain in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
